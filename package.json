{
  "name": "speech-to-text",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "spike": "node research/audit-sherpa.mjs",
    "spike:build-speaker": "powershell -NoProfile -ExecutionPolicy Bypass -File research/build-speaker.ps1",
    "spike:extract-model": "node research/extract-packaged-model.mjs",
    "spike:infer": "node research/speaker-smoke.mjs",
    "spike:browser": "node research/browser-speaker-smoke.mjs",
    "spike:prepare-asr": "node research/prepare-asr.mjs",
    "spike:generate-asr-fixture": "powershell -NoProfile -File research/generate-asr-fixture.ps1",
    "spike:build-asr": "powershell -NoProfile -ExecutionPolicy Bypass -File research/build-speaker.ps1 -Kind asr",
    "spike:asr": "node research/asr-smoke.mjs",
    "spike:asr-startup": "node research/asr-startup.mjs",
    "spike:asr-browser": "node research/browser-asr-smoke.mjs",
    "spike:live-asr": "node research/browser-live-asr.mjs",
    "spike:prepare-pipeline": "node research/prepare-pipeline.mjs",
    "spike:build-pipeline": "powershell -NoProfile -ExecutionPolicy Bypass -File research/build-speaker.ps1 -Kind pipeline",
    "spike:pipeline": "node research/pipeline-smoke.mjs",
    "spike:pipeline-stress": "node research/pipeline-stress.mjs",
    "spike:pipeline-browser": "node research/browser-live-asr.mjs --pipeline",
    "verify:speaker-assets": "node scripts/verify-speaker-assets.mjs",
    "build": "npm run typecheck && npm run verify:speaker-assets && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "check": "npm run typecheck && npm run lint && npm test && npm run build"
  },
  "dependencies": { "react": "^19.2.0", "react-dom": "^19.2.0" },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.61.0",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.1",
    "globals": "^17.3.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.3.1",
    "vitest": "^3.2.4"
  }
}
