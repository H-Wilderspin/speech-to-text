{
  "name": "speech-to-text",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.20.0"
  },
  "scripts": {
    "dev": "node --use-system-ca node_modules/vite/bin/vite.js --host 0.0.0.0",
    "service:dev": "wrangler dev --config service/wrangler.jsonc --local",
    "service:setup": "node --use-system-ca service/setup-github.mjs",
    "test:setup": "node --test service/setup-github.test.mjs",
    "service:migrate:local": "wrangler d1 migrations apply DB --local --config service/wrangler.jsonc",
    "service:build": "wrangler deploy --dry-run --config service/wrangler.jsonc --outdir .wrangler/service-build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:family": "playwright test --config playwright.family.config.ts",
    "test:owner": "playwright test --config playwright.owner.config.ts",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "check": "npm run typecheck && npm run lint && npm test && npm run test:setup && npm run build"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.61.0",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.1",
    "globals": "^17.3.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.3.1",
    "vitest": "^3.2.4",
    "wrangler": "^4.168.0"
  }
}
